# انسخ نفس القيم إلى Vercel → Settings → Environment Variables (لا ترفعه بقيم حقيقية إلى GitHub)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# هذا المفتاح لا يظهر أبدًا في المتصفح — يُستخدم فقط داخل app/api/ai-parse
GEMINI_API_KEY=your-gemini-key
